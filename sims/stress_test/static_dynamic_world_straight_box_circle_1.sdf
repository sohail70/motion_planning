<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="default">
  
<physics type="ode">
    <max_step_size>0.01</max_step_size>
    <real_time_update_rate>60</real_time_update_rate>
</physics>  
  
    <!-- Add a ground plane with a lighter color -->
<model name="ground_plane">
  <static>true</static>
  <link name="link">
    <collision name="collision">
      <geometry>
        <plane>
          <normal>0 0 1</normal>
      <size>100 100</size>
        </plane>
      </geometry>
      <!-- Disable collisions with kinematic objects -->
      <surface>
        <contact>
          <collide_without_contact_bitmask>0x01</collide_without_contact_bitmask>
        </contact>
      </surface>
    </collision>
    <visual name="visual">
      <geometry>
        <plane>
          <normal>0 0 1</normal>
          <size>100 100</size>
        </plane>
      </geometry>
      <material>
        <ambient>0.6 0.6 0.6 1</ambient>
        <diffuse>0.6 0.6 0.6 1</diffuse>
      </material>
    </visual>
  </link>
</model>



<!-- ===== STATIC CORRIDOR WALLS ===== -->
<model name="wall_top"><pose>0 10 0 0 0 0</pose><static>true</static>
  <link name="l"><visual name="v"><geometry><box><size>100 0.5 2</size></box></geometry>
    <material><ambient>0.4 0.4 0.4 1</ambient></material></visual></link></model>
<model name="wall_bottom"><pose>0 -10 0 0 0 0</pose><static>true</static>
  <link name="l"><visual name="v"><geometry><box><size>100 0.5 2</size></box></geometry>
    <material><ambient>0.4 0.4 0.4 1</ambient></material></visual></link></model>

<!-- ===== DYNAMIC SWEEPERS – moderate speed, out of phase ===== -->
<model name="s1"><pose>40 0 0 0 0 0</pose><link name="l"><gravity>false</gravity><visual name="v"><geometry><cylinder><radius>1.5</radius><length>1</length></cylinder></geometry><material><ambient>1 0 0 1</ambient></material></visual></link>
  <motion>
    <link_name>l</link_name><direction>0 1 0</direction><amplitude>6</amplitude><speed>10</speed><turnaround_threshold>0.5</turnaround_threshold></motion></model>
<model name="s2"><pose>30 0 0 0 0 0</pose><link name="l"><gravity>false</gravity><visual name="v"><geometry><cylinder><radius>1.5</radius><length>1</length></cylinder></geometry><material><ambient>0 1 0 1</ambient></material></visual></link>
  <motion>
    <link_name>l</link_name><direction>0 -1 0</direction><amplitude>6</amplitude><speed>12</speed><turnaround_threshold>0.5</turnaround_threshold></motion></model>
<model name="s3"><pose>20 0 0 0 0 0</pose><link name="l"><gravity>false</gravity><visual name="v"><geometry><cylinder><radius>1.5</radius><length>1</length></cylinder></geometry><material><ambient>0 0 1 1</ambient></material></visual></link>
  <motion>
    <link_name>l</link_name><direction>0 1 0</direction><amplitude>6</amplitude><speed>14</speed><turnaround_threshold>0.5</turnaround_threshold></motion></model>
<model name="s4"><pose>10 0 0 0 0 0</pose><link name="l"><gravity>false</gravity><visual name="v"><geometry><cylinder><radius>1.5</radius><length>1</length></cylinder></geometry><material><ambient>1 1 0 1</ambient></material></visual></link>
  <motion>
    <link_name>l</link_name><direction>0 -1 0</direction><amplitude>6</amplitude><speed>10</speed><turnaround_threshold>0.5</turnaround_threshold></motion></model>
<model name="s5"><pose>0 0 0 0 0 0</pose><link name="l"><gravity>false</gravity><visual name="v"><geometry><cylinder><radius>1.5</radius><length>1</length></cylinder></geometry><material><ambient>1 0 1 1</ambient></material></visual></link>
  <motion>
    <link_name>l</link_name><direction>0 1 0</direction><amplitude>6</amplitude><speed>12</speed><turnaround_threshold>0.5</turnaround_threshold></motion></model>
<model name="s6"><pose>-10 0 0 0 0 0</pose><link name="l"><gravity>false</gravity><visual name="v"><geometry><cylinder><radius>1.5</radius><length>1</length></cylinder></geometry><material><ambient>0 1 1 1</ambient></material></visual></link>
  <motion>
    <link_name>l</link_name><direction>0 -1 0</direction><amplitude>6</amplitude><speed>16</speed><turnaround_threshold>0.5</turnaround_threshold></motion></model>
<model name="s7"><pose>-20 0 0 0 0 0</pose><link name="l"><gravity>false</gravity><visual name="v"><geometry><cylinder><radius>1.5</radius><length>1</length></cylinder></geometry><material><ambient>1 0.5 0 1</ambient></material></visual></link>
  <motion>
    <link_name>l</link_name><direction>0 1 0</direction><amplitude>6</amplitude><speed>14</speed><turnaround_threshold>0.5</turnaround_threshold></motion></model>
<model name="s8"><pose>-30 0 0 0 0 0</pose><link name="l"><gravity>false</gravity><visual name="v"><geometry><cylinder><radius>1.5</radius><length>1</length></cylinder></geometry><material><ambient>0 0.5 1 1</ambient></material></visual></link>
  <motion>
    <link_name>l</link_name><direction>0 -1 0</direction><amplitude>6</amplitude><speed>10</speed><turnaround_threshold>0.5</turnaround_threshold></motion></model>


<!--****** -->
    <include>
      <uri>/home/sohail/gazeb/GAZEBO_MOV/model.sdf</uri>
      <name>tugbot</name>
      <pose>48.0 48.0 0.1 0 0 0</pose>

<!-- 
  <motion type="legacy-teleport">
    <speed>0.8</speed>
    <interpolation_step>0.3</interpolation_step>
  </motion> -->


    </include>

  </world>
</sdf>





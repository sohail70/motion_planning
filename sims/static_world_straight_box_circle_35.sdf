  <link name="moving_link">
    <gravity>false</gravity>
    <visual name="visual">
      <geometry>
        <box><size>4.0 16.0 1.0</size></box>
      </geometry>
      <material>
        <ambient>0.8 0 0.8 1</ambient>
      </material>
    </visual>
  </link>
  <plugin name="MoverPluginC" filename="/home/sohail/gazeb/GAZEBO_MOV/build/libMoverPluginC.so">
    <link_name>moving_link</link_name>
    <direction>1 0 0</direction>
    <amplitude>0</amplitude>
    <speed>0</speed>
    <turnaround_threshold>0.5</turnaround_threshold>
  </plugin>
</model>

<!-- Cluster obstacles: force detours around dense groups -->
<model name="moving_cylinder_21">
  <pose>-30.0 30.0 0 0 0 0</pose>
  <link name="moving_link">
    <gravity>false</gravity>
    <visual name="visual">
      <geometry>
        <cylinder>
          <radius>2.5</radius>
          <length>1.0</length>

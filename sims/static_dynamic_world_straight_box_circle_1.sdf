<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="default">
  
<physics type="ode">
    <max_step_size>0.01</max_step_size>
    <real_time_update_rate>60</real_time_update_rate>
</physics>  
  
    <!-- Add a ground plane with a lighter color -->
<model name="ground_plane">
  <static>true</static>
  <link name="link">
    <collision name="collision">
      <geometry>
        <plane>
          <normal>0 0 1</normal>
      <size>100 100</size>
        </plane>
      </geometry>
      <!-- Disable collisions with kinematic objects -->
      <surface>
        <contact>
          <collide_without_contact_bitmask>0x01</collide_without_contact_bitmask>
        </contact>
      </surface>
    </collision>
    <visual name="visual">
      <geometry>
        <plane>
          <normal>0 0 1</normal>
          <size>100 100</size>
        </plane>
      </geometry>
      <material>
        <ambient>0.6 0.6 0.6 1</ambient>
        <diffuse>0.6 0.6 0.6 1</diffuse>
      </material>
    </visual>
  </link>
</model>



  <!-- BARRIER 1 (at Y=20): Two narrow slits with high-speed oscillators -->
  <!-- Slit A at X=10, Slit B at X=-10 -->
  <model name="b1_wall_center">
    <pose>0 20 0 0 0 0</pose>
    <link name="l"><visual name="v"><geometry><box><size>10 2 1</size></box></geometry></visual></link>
  </model>
  <model name="b1_wall_left">
    <pose>-40 20 0 0 0 0</pose>
    <link name="l"><visual name="v"><geometry><box><size>45 2 1</size></box></geometry></visual></link>
  </model>
  <model name="b1_wall_right">
    <pose>40 20 0 0 0 0</pose>
    <link name="l"><visual name="v"><geometry><box><size>45 2 1</size></box></geometry></visual></link>
  </model>

  <!-- The "Oscillating Trap": These move 180 degrees out of phase -->
  <model name="b1_trap_a">
    <pose>8 20 0 0 0 0</pose>
    <link name="link"><visual name="v"><geometry><box><size>6 2.2 1</size></box></geometry><material><ambient>1 0 0 1</ambient></material></visual></link>
    <motion>
      <direction>1 0 0</direction>
      <amplitude>6.0</amplitude> <!-- Short, fast oscillations -->
      <speed>8.0</speed>         <!-- Very high speed to flicker the tube -->
    </motion>
  </model>

  <model name="b1_trap_b">
    <pose>-8 20 0 0 0 0</pose>
    <link name="link"><visual name="v"><geometry><box><size>6 2.2 1</size></box></geometry><material><ambient>1 0 0 1</ambient></material></visual></link>
    <motion>
      <direction>-1 0 0</direction>
      <amplitude>6.0</amplitude>
      <speed>8.0</speed>
    </motion>
  </model>

  <!-- BARRIER 2 (at Y=0): Repeat the structure but offset the slits -->
  <model name="b2_trap_a">
    <pose>20 0 0 0 0 0</pose>
    <link name="link"><visual name="v"><geometry><box><size>6 2.2 1</size></box></geometry><material><ambient>1 0 0 1</ambient></material></visual></link>
    <motion>
      <direction>1 0 0</direction>
      <amplitude>5.0</amplitude>
      <speed>10.0</speed>
    </motion>
  </model>


<!--****** -->
    <include>
      <uri>/home/sohail/gazeb/GAZEBO_MOV/model.sdf</uri>
      <name>tugbot</name>
      <pose>48.0 48.0 0.1 0 0 0</pose>

<!-- 
  <motion type="legacy-teleport">
    <speed>0.8</speed>
    <interpolation_step>0.3</interpolation_step>
  </motion> -->


    </include>

  </world>
</sdf>





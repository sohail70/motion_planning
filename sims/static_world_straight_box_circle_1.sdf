<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="default">
  
<physics type="ode">
    <max_step_size>0.01</max_step_size>
    <real_time_update_rate>60</real_time_update_rate>
</physics>  
  
    <!-- Add a ground plane with a lighter color -->
<model name="ground_plane">
  <static>true</static>
  <link name="link">
    <collision name="collision">
      <geometry>
        <plane>
          <normal>0 0 1</normal>
      <size>100 100</size>
        </plane>
      </geometry>
      <!-- Disable collisions with kinematic objects -->
      <surface>
        <contact>
          <collide_without_contact_bitmask>0x01</collide_without_contact_bitmask>
        </contact>
      </surface>
    </collision>
    <visual name="visual">
      <geometry>
        <plane>
          <normal>0 0 1</normal>
          <size>100 100</size>
        </plane>
      </geometry>
      <material>
        <ambient>0.6 0.6 0.6 1</ambient>
        <diffuse>0.6 0.6 0.6 1</diffuse>
      </material>
    </visual>
  </link>
</model>


<!-- Static cylinders scattered in x,y ∈ [-50, 50] -->
<model name="moving_cylinder_1">
  <pose>10.0 10.0 0 0 0 0</pose>
  <link name="moving_link">
    <gravity>false</gravity>
    <visual name="visual">
      <geometry>
        <cylinder>
          <radius>35.0</radius>
          <length>1.0</length>
        </cylinder>
      </geometry>
      <material>
        <ambient>0 0 1 1</ambient>
      </material>
    </visual>
  </link>
  <motion>
    <link_name>moving_link</link_name>
    <direction>1 0 0</direction>
    <amplitude>0</amplitude>    <!-- no movement -->
    <speed>0</speed>            <!-- stationary -->
    <turnaround_threshold>0.5</turnaround_threshold>
  </motion>
</model>


<!--****** -->
    <include>
      <uri>/home/sohail/gazeb/GAZEBO_MOV/model.sdf</uri>
      <name>tugbot</name>
      <pose>48.0 48.0 0.1 0 0 0</pose>

<!-- 
  <motion type="legacy-teleport">
    <speed>0.8</speed>
    <interpolation_step>0.3</interpolation_step>
  </motion> -->


    </include>

  </world>
</sdf>





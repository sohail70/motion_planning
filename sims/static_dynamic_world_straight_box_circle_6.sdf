<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="default">
  
<physics type="ode">
    <max_step_size>0.01</max_step_size>
    <real_time_update_rate>60</real_time_update_rate>
</physics>  
  
    <!-- Add a ground plane with a lighter color -->
<model name="ground_plane">
  <static>true</static>
  <link name="link">
    <collision name="collision">
      <geometry>
        <plane>
          <normal>0 0 1</normal>
      <size>100 100</size>
        </plane>
      </geometry>
      <!-- Disable collisions with kinematic objects -->
      <surface>
        <contact>
          <collide_without_contact_bitmask>0x01</collide_without_contact_bitmask>
        </contact>
      </surface>
    </collision>
    <visual name="visual">
      <geometry>
        <plane>
          <normal>0 0 1</normal>
          <size>100 100</size>
        </plane>
      </geometry>
      <material>
        <ambient>0.6 0.6 0.6 1</ambient>
        <diffuse>0.6 0.6 0.6 1</diffuse>
      </material>
    </visual>
  </link>
</model>


<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="default">
  
<physics type="ode">
    <max_step_size>0.01</max_step_size>
    <real_time_update_rate>60</real_time_update_rate>
</physics>  
  
    <!-- Add a ground plane with a lighter color -->
<model name="ground_plane">
  <static>true</static>
  <link name="link">
    <collision name="collision">
      <geometry>
        <plane>
          <normal>0 0 1</normal>
      <size>100 100</size>
        </plane>
      </geometry>
      <!-- Disable collisions with kinematic objects -->
      <surface>
        <contact>
          <collide_without_contact_bitmask>0x01</collide_without_contact_bitmask>
        </contact>
      </surface>
    </collision>
    <visual name="visual">
      <geometry>
        <plane>
          <normal>0 0 1</normal>
          <size>100 100</size>
        </plane>
      </geometry>
      <material>
        <ambient>0.6 0.6 0.6 1</ambient>
        <diffuse>0.6 0.6 0.6 1</diffuse>
      </material>
    </visual>
  </link>
</model>

<!-- BOTTOM WALL of the pocket -->
<model name="static_wall_bottom">
  <!-- Spans from X=-5 to X=25. It stops just short of the corner to leave a gap -->
  <pose>10.0 -10.0 0 0 0 0</pose>
  <link name="wall_link">
    <gravity>false</gravity>
    <visual name="visual">
      <geometry>
        <box><size>30.0 2.0 1.0</size></box>
      </geometry>
      <material><ambient>0.5 0.5 0.5 1</ambient></material>
    </visual>
  </link>
</model>

<!-- LEFT WALL of the pocket -->
<model name="static_wall_left">
  <!-- Spans from Y=-5 to Y=25. It stops just short of the corner to leave a gap -->
  <pose>-10.0 10.0 0 0 0 0</pose>
  <link name="wall_link">
    <gravity>false</gravity>
    <visual name="visual">
      <geometry>
        <box><size>2.0 30.0 1.0</size></box>
      </geometry>
      <material><ambient>0.5 0.5 0.5 1</ambient></material>
    </visual>
  </link>
</model>

<!-- THE DYNAMIC PLUG (Seals the corner gap) -->
<model name="dynamic_plug">
  <!-- Starts out of the way at X=-20 -->
  <pose>-20.0 -10.0 0 0 0 0</pose> 
  <link name="moving_link">
    <gravity>false</gravity>
    <visual name="visual">
      <geometry>
        <box><size>10.0 2.0 1.0</size></box>
      </geometry>
      <material><ambient>1 0 0 1</ambient></material> <!-- Red Threat -->
    </visual>
  </link>
  <plugin name="MoverPluginC" filename="/home/sohail/gazeb/GAZEBO_MOV/build/libMoverPluginC.so">
    <link_name>moving_link</link_name>
    <direction>1 0 0</direction> <!-- Moves horizontally along X -->
    <amplitude>15.0</amplitude>  <!-- Sweeps from X=-20 to X=-5 -->
    <speed>5.0</speed>           <!-- Moves fast! -->
    <turnaround_threshold>0.5</turnaround_threshold>
  </plugin>
</model>



<!--****** -->
    <include>
      <uri>/home/sohail/gazeb/GAZEBO_MOV/model.sdf</uri>
      <name>tugbot</name>
      <pose>48.0 48.0 0.1 0 0 0</pose>


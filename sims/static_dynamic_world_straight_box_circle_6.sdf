    <interpolation_step>0.3</interpolation_step>
  </plugin> -->


    </include>

  </world>
</sdf>












<!-- LEFT STATIC WALL -->
<model name="left_wall">
  <pose>-12.0 10.0 0 0 0 0</pose>
  <link name="wall_link">
    <gravity>false</gravity>
    <visual name="visual">
      <geometry>
        <box><size>16.0 30.0 1.0</size></box>
      </geometry>
      <material><ambient>0.5 0.5 0.5 1</ambient></material>
    </visual>
  </link>
</model>

<!-- RIGHT STATIC WALL -->
<model name="right_wall">
  <pose>12.0 10.0 0 0 0 0</pose>
  <link name="wall_link">
    <gravity>false</gravity>
    <visual name="visual">
      <geometry>
        <box><size>16.0 30.0 1.0</size></box>
      </geometry>
      <material><ambient>0.5 0.5 0.5 1</ambient></material>
    </visual>
  </link>
</model>

<!-- THE DYNAMIC GATE (Plugs the exit) -->
<model name="dynamic_gate">
  <!-- Starts on the left side of the exit -->
  <pose>-5.0 27.0 0 0 0 0</pose> 
  <link name="moving_link">
    <gravity>false</gravity>
    <visual name="visual">
      <geometry>
        <!-- 10m wide to completely plug the 8m corridor -->
        <box><size>10.0 2.0 1.0</size></box>
      </geometry>
      <material><ambient>1 0 0 1</ambient></material> <!-- Red threat! -->
    </visual>
  </link>
  <plugin name="MoverPluginC" filename="/home/sohail/gazeb/GAZEBO_MOV/build/libMoverPluginC.so">
    <link_name>moving_link</link_name>
    <direction>1 0 0</direction> <!-- Moves along X axis -->
    <amplitude>10.0</amplitude>  <!-- Moves from X=-5 to X=+5 -->
    <speed>5.0</speed>           <!-- Fast! 2 seconds to close the gate -->
    <turnaround_threshold>0.5</turnaround_threshold>
  </plugin>
</model>




<model name="moving_cylinder_1111">
<pose>-55.0 30.0 0 0 0 0</pose>
    <link name="moving_link">
                  <gravity>false</gravity>

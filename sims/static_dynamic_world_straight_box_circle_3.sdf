<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="default">
  
<physics type="ode">
    <max_step_size>0.01</max_step_size>
    <real_time_update_rate>60</real_time_update_rate>
</physics>  
  
    <!-- Add a ground plane with a lighter color -->
<model name="ground_plane">
  <static>true</static>
  <link name="link">
    <collision name="collision">
      <geometry>
        <plane>
          <normal>0 0 1</normal>
      <size>100 100</size>
        </plane>
      </geometry>
      <!-- Disable collisions with kinematic objects -->
      <surface>
        <contact>
          <collide_without_contact_bitmask>0x01</collide_without_contact_bitmask>
        </contact>
      </surface>
    </collision>
    <visual name="visual">
      <geometry>
        <plane>
          <normal>0 0 1</normal>
          <size>100 100</size>
        </plane>
      </geometry>
      <material>
        <ambient>0.6 0.6 0.6 1</ambient>
        <diffuse>0.6 0.6 0.6 1</diffuse>
      </material>
    </visual>
  </link>
</model>






<!-- ======================================================= -->
<!-- THE COMB CEILING & FLOOR                                -->
<!-- ======================================================= -->

<!-- Top Ceiling of the main corridor (y=8) -->
<model name="comb_ceiling">
  <pose>0.0 8.0 0 0 0 0</pose>
  <link name="wall_link"><gravity>false</gravity><visual name="visual"><geometry>
    <box><size>64.0 4.0 1.0</size></box>
  </geometry><material><ambient>0.3 0.3 0.3 1</ambient></material></visual></link>
</model>

<!-- Bottom Floor of the trenches (y=-24) -->
<model name="comb_floor">
  <pose>0.0 -24.0 0 0 0 0</pose>
  <link name="wall_link"><gravity>false</gravity><visual name="visual"><geometry>
    <box><size>64.0 4.0 1.0</size></box>
  </geometry><material><ambient>0.3 0.3 0.3 1</ambient></material></visual></link>
</model>

<!-- Back Wall (Forces robot to enter from the right side) -->
<model name="comb_back_wall">
  <pose>30.0 -8.0 0 0 0 0</pose>
  <link name="wall_link"><gravity>false</gravity><visual name="visual"><geometry>
    <box><size>4.0 32.0 1.0</size></box>
  </geometry><material><ambient>0.3 0.3 0.3 1</ambient></material></visual></link>
</model>

<!-- ======================================================= -->
<!-- THE TRENCHES (The 5 dead-ends pointing at the goal)     -->
<!-- ======================================================= -->
<!-- The teeth span from y=-22 up to y=-2, leaving a corridor between y=-2 and y=6 -->

<model name="tooth_1">
  <pose>20.0 -12.0 0 0 0 0</pose>
  <link name="wall_link"><gravity>false</gravity><visual name="visual"><geometry>
    <box><size>2.0 20.0 1.0</size></box>
  </geometry><material><ambient>0.8 0.6 0.0 1</ambient></material></visual></link>
</model>

<model name="tooth_2">
  <pose>10.0 -12.0 0 0 0 0</pose>
  <link name="wall_link"><gravity>false</gravity><visual name="visual"><geometry>
    <box><size>2.0 20.0 1.0</size></box>
  </geometry><material><ambient>0.8 0.6 0.0 1</ambient></material></visual></link>
</model>

<model name="tooth_3">
  <pose>0.0 -12.0 0 0 0 0</pose>
  <link name="wall_link"><gravity>false</gravity><visual name="visual"><geometry>
    <box><size>2.0 20.0 1.0</size></box>
  </geometry><material><ambient>0.8 0.6 0.0 1</ambient></material></visual></link>
</model>

<model name="tooth_4">
  <pose>-10.0 -12.0 0 0 0 0</pose>
  <link name="wall_link"><gravity>false</gravity><visual name="visual"><geometry>
    <box><size>2.0 20.0 1.0</size></box>
  </geometry><material><ambient>0.8 0.6 0.0 1</ambient></material></visual></link>
</model>

<model name="tooth_5">
  <pose>-20.0 -12.0 0 0 0 0</pose>
  <link name="wall_link"><gravity>false</gravity><visual name="visual"><geometry>
    <box><size>2.0 20.0 1.0</size></box>
  </geometry><material><ambient>0.8 0.6 0.0 1</ambient></material></visual></link>
</model>

<!-- ======================================================= -->
<!-- THE GUILLOTINE (The Trap Spring)                        -->
<!-- ======================================================= -->

<!-- Starts out of the way above the corridor, slams down to seal the left exit -->
<model name="dynamic_guillotine">
  <pose>-28.0 20.0 0 0 0 0</pose> 
  <link name="moving_link">
    <gravity>false</gravity>
    <visual name="visual"><geometry>
      <box><size>4.0 16.0 1.0</size></box>
    </geometry><material><ambient>1 0 0 1</ambient></material></visual></link>
  <plugin name="MoverPluginC" filename="/home/sohail/gazeb/GAZEBO_MOV/build/libMoverPluginC.so">
    <link_name>moving_link</link_name>
    <direction>0 -1 0</direction> <!-- Moves straight down (Negative Y) -->
    <amplitude>20.0</amplitude>  <!-- Drops from y=20 down to y=0 -->
    <speed>10.0</speed>          <!-- Extremely fast drop -->
    <turnaround_threshold>0.5</turnaround_threshold>
  </plugin>
</model>





<!--****** -->
    <include>
      <uri>/home/sohail/gazeb/GAZEBO_MOV/model.sdf</uri>
      <name>tugbot</name>
      <pose>48.0 48.0 0.1 0 0 0</pose>


<model name="moving_cylinder_2">
<pose>0.0 -35.0 0 0 0 0</pose>
    <link name="moving_link">
                      <gravity>false</gravity>
    <kinematic>true</kinematic>
    <visual name="visual">
      <geometry>
        <cylinder>
          <radius>6.0</radius>
          <length>1.0</length>
        </cylinder>
      </geometry>
      <material>
        <ambient>0 0 1 1</ambient>
      </material>
    </visual>
    </link>

    <motion>
        <link_name>moving_link</link_name>
        <direction>0 1 0</direction>  <!-- Move along x-axis -->
        <amplitude>40.0</amplitude>    <!-- 0.5 meters -->
        <speed>8.0</speed>            <!-- 2 rad/s -->
    </motion>
</model>




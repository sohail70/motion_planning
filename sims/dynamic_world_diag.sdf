<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="default">
    <!-- Add a ground plane with a lighter color -->
<model name="ground_plane">
  <static>true</static>
  <link name="link">
    <collision name="collision">
      <geometry>
        <plane>
          <normal>0 0 1</normal>
      <size>100 100</size>
        </plane>
      </geometry>
      <!-- Disable collisions with kinematic objects -->
      <surface>
        <contact>
          <collide_without_contact_bitmask>0x01</collide_without_contact_bitmask>
        </contact>
      </surface>
    </collision>
    <visual name="visual">
      <geometry>
        <plane>
          <normal>0 0 1</normal>
          <size>100 100</size>
        </plane>
      </geometry>
      <material>
        <ambient>0.6 0.6 0.6 1</ambient>
        <diffuse>0.6 0.6 0.6 1</diffuse>
      </material>
    </visual>
  </link>
</model>

<!-- Solid diagonal wall (phalanx) – no gaps -->
<model name="moving_cylinder_20">
  <pose>22.6 -22.6 0 0 0 0</pose>
  <link name="moving_link">
    <gravity>false</gravity>
    <visual name="visual">
      <geometry><cylinder><radius>4.5</radius><length>1.0</length></cylinder></geometry>
      <material><ambient>0.9 0.2 0.2 1</ambient></material>
    </visual>
  </link>
  <motion>
    <link_name>moving_link</link_name>
    <direction>0.707 0.707 0</direction>
    <amplitude>25.0</amplitude>
    <speed>20.0</speed>
    <turnaround_threshold>0.5</turnaround_threshold>
  </motion>
</model>

